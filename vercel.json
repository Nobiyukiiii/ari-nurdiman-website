{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node site/build.mjs",
  "outputDirectory": "site/dist",
  "headers": [
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
